# Frontend environment template.
# Copy to `.env.local` (never commit real values) and adjust as needed.

# Data-layer implementation. Real CMS HTTP is the default when unset; use
# "mock" only explicitly for isolated deterministic fixture development.
NEXT_PUBLIC_API_MODE=real

# Base URL prefix for the CMS API. The default `/api/v1` is proxied to
# BACKEND_ORIGIN by Next.js rewrites (see next.config.ts), which avoids CORS
# during development. Point it at an absolute backend URL to bypass the proxy.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend origin used by the Next.js dev/prod proxy for /api/v1/*.
# Server-side only; not exposed to the browser bundle.
BACKEND_ORIGIN=http://127.0.0.1:8000
