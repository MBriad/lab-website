# Use URL-safe characters because this value is embedded in DATABASE_URL.
# Example (PowerShell): -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
SECRET_KEY=replace-with-a-long-random-signing-key
FRONTEND_ORIGINS=http://localhost:3000

# Host port for the public Next.js container. Backend and PostgreSQL stay
# reachable only through the internal Compose network by default.
FRONTEND_PORT=3000

# These values are baked into the frontend bundle at image-build time and are
# also supplied to the runtime container for server-side rendering.
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Import the tracked CMS snapshot into a brand-new PostgreSQL volume once.
# Set to false when provisioning an intentionally empty database.
SEED_SNAPSHOT=true
