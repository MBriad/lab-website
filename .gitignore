# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node / Next.js
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
.vercel
*.tsbuildinfo
next-env.d.ts

# Testing and Python
/coverage
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Environment files (the documented example is safe and intentionally tracked)
.env*
!.env.example

# Miscellaneous
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime CMS data is ignored by default. The sanitized snapshot currently
# tracked in backend/data is intentionally force-added for local reproduction.
backend/data/*
!backend/data/.gitkeep
